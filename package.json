{
  "name": "hanu-lms-mcp",
  "version": "0.0.1",
  "description": "hanu-lms-mcp MCP server",
  "type": "module",
  "bin": {
    "hanu-lms-mcp": "./dist/index.js",
    "hanu-lms-setup": "./scripts/setup.mjs"
  },
  "files": [
    "dist",
    "scripts/setup.mjs"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hanu",
    "moodle",
    "lms"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && mcp-build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "test": "tsc && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:live": "tsc && node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "mcp-framework": "^0.2.22",
    "parse5": "7.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
